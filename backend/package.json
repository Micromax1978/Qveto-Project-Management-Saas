  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.js\"",
    "test:all": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",

# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qveto?schema=public

# Long random string (>= 16 chars), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000

# Comma-separated list of browser origins allowed to call the API ("*" = any)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Set when running behind a reverse proxy (so rate limiting sees client IPs)
# TRUST_PROXY=1

# Where uploaded attachments are stored (default: backend/storage/attachments)
# UPLOAD_DIR=./storage/attachments

# Overdue scan interval in milliseconds (default 900000 = 15 min, 0 = disabled)
# OVERDUE_SCAN_INTERVAL_MS=900000

# Simulated email notifications (written to logs/email-outbox.log, NOT sent)
# EMAIL_NOTIFICATIONS=true

# debug | info | warn | error | silent
# LOG_LEVEL=info
